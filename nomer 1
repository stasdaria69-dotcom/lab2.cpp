#include <iostream>
using namespace std;
int main() {
	setlocale(LC_ALL, "Rus");
	double v;
	cout << "Введите объем потреблённой электроэнергии:\n";
	cin >> v;
    if (v >= 0) {  
		if (v <= 100) {
			cout << "Достигнут диапазон: первые 100 единиц\n";
			cout << "Стоимость первой части (по 0.20):\n";
			cout << v * 0.20;
			cout << "\n";
			cout << "Цена за весь объем:\n";
			cout << v * 0.20;
			cout << "\n";
		}
		else {
			if (v <= 200) {
				cout << "Достигнут диапазон: следующие 100 единиц (до 200)\n";
				cout << "Стоимость первой части (за 100 ед.):\n";
				cout << 100 * 0.20;
				cout << "\n";
				cout << "Цена за объем от 100 до 200 (по 0.30):\n";
				cout << (v - 100) * 0.30;
				cout << "\n";
				cout << "Цена за весь объем:\n";
				cout << 100 * 0.20 + (v - 100) * 0.30;
				cout << "\n";
			}
			else {
				cout << "Достигнут диапазон: все сверх 200 единиц\n";
				cout << "Стоимость первой части (за 100 ед.):\n";
				cout << 100 * 0.20;
				cout << "\n";
				cout << "Цена за вторую часть (за 100 ед.):\n";
				cout << 100 * 0.30;
				cout << "\n";
				cout << "Цена за объем больше 200 (по 0.45):\n";
				cout << (v - 200) * 0.45;
				cout << "\n";
				cout << "Цена за весь объем:\n";
				cout << 100 * 0.20 + 100 * 0.30 + (v - 200) * 0.45;
				cout << "\n";
			}
		}
	}
	else {
		cout << "Введено отрицательное число. Попробуйте еще раз\n";
	}

	return 0;
}
