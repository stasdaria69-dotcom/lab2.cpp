#include <iostream>
using namespace std;
int main() {
	setlocale(LC_ALL, "Rus");
	double v;
	bool isLgota;
	cout << "Введите объем воды:\n";
	cin >> v;
	cout << "Есть ли льгота(0,1):\n";
	cin >> isLgota;
	if (v >= 0) {
		if (isLgota == 1) {
			if (v <= 10) {
				cout << "Стоимость льготной части:\n";
				cout << v * 0.8;
				cout << "Стоимость повышенной части:\n";
				cout << 0 << "\n";
				cout << "Цена за весь объем:\n";
				cout << v * 0.8 << "\n";

			}
			else {
				cout << "Стоимость за первые 10:\n";
				cout << 10 * 0.8;
				cout << "\n";
				cout << "Цена за объем больше 10;\n";
				cout << (v - 10) * 1.5;
				cout << "\n";
				cout << "Цена за весь объем:\n";
				cout << 10 * 0.8 + (v - 10) * 1.5;
				cout << "\n";
			}
		}

		else {
			cout << "Стоимость не льготной части:\n";
			cout << v * 1;
			cout << "\n";
			cout << "Стоимость за первые 10:\n";
			cout << 10 * 1;
			cout << "\n";
			cout << "Цена за объем больше 10;\n";
			cout << (v - 10) * 1.5;
			cout << "\n";
			cout << "Цена за весь объем:\n";
			cout << 10 * 1 + (v - 10) * 1.5;
		}

	}
	else {
		cout << "Введено не положительное число.Попробуйте еще раз";
	}

	return 0;
}
